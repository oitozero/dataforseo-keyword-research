# Copy to .env and fill in. Do not commit .env or the service account file.

# API login and password from https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# The ID in the spreadsheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# Path to a Google service account JSON key. Share the spreadsheet with that
# account's client_email as an Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
